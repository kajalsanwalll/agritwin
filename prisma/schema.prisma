generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Polyhouse {
  id        String   @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime @default(now())

  cropProfileId String
  cropProfile   CropProfile @relation(fields: [cropProfileId], references: [id])

  sensorReadings SensorReading[]
}

model CropProfile {
  id                String @id @default(cuid())
  name              String @unique

  minTemperature    Float
  maxTemperature    Float

  minHumidity       Float
  maxHumidity       Float

  minSoilMoisture   Float
  maxSoilMoisture   Float

  polyhouses        Polyhouse[]
}

model SensorReading {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())

  temperature    Float
  humidity       Float
  soilMoisture   Float
  lightIntensity Float
  co2            Float

  polyhouseId    String
  polyhouse      Polyhouse @relation(fields: [polyhouseId], references: [id])

  @@index([polyhouseId, timestamp])
}